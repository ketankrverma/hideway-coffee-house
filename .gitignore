# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build output
/.next/
/out/
/build
/dist

# Environment variables & secrets (Never commit secrets)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Vercel deployment cache & artifacts
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Operating System files
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE & Editor files
.vscode/
.idea/

# Debug logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
